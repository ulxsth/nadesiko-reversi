# グラデーションリバーシ ルールエンジンCLI v1
# stdin: runtime-request.schema.json
# stdout: runtime-response.schema.json
#
# ルール本体はrules.nako3にあり、このファイルは入出力と自己テストだけを持つ。

!「rules.nako3」を取り込む

●自己テストとは
    新規要求={}
    新規要求[「version」]=「1」
    新規要求[「action」]=「newGame」
    新規要求[「gameId」]=「test-game」
    新規要求[「seed」]=1
    新規応答=新規要求で要求評価
    真と新規応答[「ok」]がASSERT等
    状態=新規応答[「state」]
    60と状態[「nextColor」]がASSERT等
    1015568748と状態[「rngState」]がASSERT等
    12と(状態[「legalMoves」]の要素数)がASSERT等

    コマンド={}
    コマンド[「commandId」]=「cmd-1」
    コマンド[「type」]=「place」
    コマンド[「player」]=「dark」
    コマンド[「expectedTurn」]=0
    コマンド[「row」]=2
    コマンド[「col」]=2
    着手要求={}
    着手要求[「version」]=「1」
    着手要求[「action」]=「applyCommand」
    着手要求[「state」]=状態
    着手要求[「command」]=コマンド
    着手応答=着手要求で要求評価
    真と着手応答[「ok」]がASSERT等
    新状態=着手応答[「state」]
    60と新状態[「board」][18]がASSERT等
    20と新状態[「board」][27]がASSERT等
    1と新状態[「turnNumber」]がASSERT等
    「light」と新状態[「currentPlayer」]がASSERT等
    1586005467と新状態[「rngState」]がASSERT等
    94と新状態[「nextColor」]がASSERT等

    不正コマンド={}
    不正コマンド[「commandId」]=「cmd-2」
    不正コマンド[「type」]=「place」
    不正コマンド[「player」]=「light」
    不正コマンド[「expectedTurn」]=1
    不正コマンド[「row」]=3
    不正コマンド[「col」]=3
    不正要求={}
    不正要求[「version」]=「1」
    不正要求[「action」]=「applyCommand」
    不正要求[「state」]=新状態
    不正要求[「command」]=不正コマンド
    不正応答=不正要求で要求評価
    偽と不正応答[「ok」]がASSERT等
    「occupied」と不正応答[「error」][「code」]がASSERT等
    1586005467と不正応答[「state」][「rngState」]がASSERT等

    # 一方向に複数駒がある盤端の着手は、着手前の色から同時変換する
    端状態=状態を深複製
    端盤面=[]
    64回:
        端盤面にNULLを配列追加
    端盤面[1]=30
    端盤面[2]=60
    端盤面[3]=90
    端状態[「board」]=端盤面
    端状態[「legalMoves」]=端盤面で合法手一覧
    2と(端状態[「legalMoves」]の要素数)がASSERT等
    0と端状態[「legalMoves」][0][「row」]がASSERT等
    0と端状態[「legalMoves」][0][「col」]がASSERT等
    端コマンド={}
    端コマンド[「commandId」]=「edge-1」
    端コマンド[「type」]=「place」
    端コマンド[「player」]=「dark」
    端コマンド[「expectedTurn」]=0
    端コマンド[「row」]=0
    端コマンド[「col」]=0
    端応答=端状態と端コマンドで着手適用
    真と端応答[「ok」]がASSERT等
    60と端応答[「state」][「board」][1]がASSERT等
    70と端応答[「state」][「board」][2]がASSERT等

    # 一つの着手で8方向を同時に変換する
    多方向状態=状態を深複製
    多方向盤面=[]
    64回:
        多方向盤面にNULLを配列追加
    方向番号で0から7まで繰り返す:
        行差=方向列[方向番号][0]
        列差=方向列[方向番号][1]
        近添字=(3+行差)と(3+列差)で盤添字
        遠添字=(3+2*行差)と(3+2*列差)で盤添字
        多方向盤面[近添字]=30
        多方向盤面[遠添字]=90
    多方向状態[「board」]=多方向盤面
    多方向状態[「legalMoves」]=多方向盤面で合法手一覧
    多方向コマンド={}
    多方向コマンド[「commandId」]=「multi-1」
    多方向コマンド[「type」]=「place」
    多方向コマンド[「player」]=「dark」
    多方向コマンド[「expectedTurn」]=0
    多方向コマンド[「row」]=3
    多方向コマンド[「col」]=3
    多方向応答=多方向状態と多方向コマンドで着手適用
    真と多方向応答[「ok」]がASSERT等
    8と(多方向応答[「event」][「changes」]の要素数)がASSERT等
    60と多方向応答[「state」][「board」][27]がASSERT等
    60と多方向応答[「state」][「board」][18]がASSERT等

    # 合法手がなければパスでき、2回連続で終了する。駒が無い盤面は色の重心が中央なので引き分け
    パス状態=状態を深複製
    空盤面=[]
    64回:
        空盤面にNULLを配列追加
    パス状態[「board」]=空盤面
    パス状態[「legalMoves」]=[]
    パスコマンド={}
    パスコマンド[「commandId」]=「pass-1」
    パスコマンド[「type」]=「pass」
    パスコマンド[「player」]=「dark」
    パスコマンド[「expectedTurn」]=0
    パス応答1=パス状態とパスコマンドでパス適用
    真とパス応答1[「ok」]がASSERT等
    1とパス応答1[「state」][「consecutivePasses」]がASSERT等
    パスコマンド2={}
    パスコマンド2[「commandId」]=「pass-2」
    パスコマンド2[「type」]=「pass」
    パスコマンド2[「player」]=「light」
    パスコマンド2[「expectedTurn」]=1
    パス応答2=パス応答1[「state」]とパスコマンド2でパス適用
    「finished」とパス応答2[「state」][「phase」]がASSERT等
    真と(パス応答2[「state」][「winner」]==NULL)がASSERT等

    # 合法手がある初期盤面ではパスを拒否し、状態を変更しない
    拒否パス={}
    拒否パス[「commandId」]=「pass-denied」
    拒否パス[「type」]=「pass」
    拒否パス[「player」]=「dark」
    拒否パス[「expectedTurn」]=0
    拒否応答=状態と拒否パスでパス適用
    「pass_not_allowed」と拒否応答[「error」][「code」]がASSERT等
    1015568748と拒否応答[「state」][「rngState」]がASSERT等

    # 最後の空きマスを埋めると終了し、暗側の勝利になる
    満杯状態=状態を深複製
    満杯盤面=[]
    64回:
        満杯盤面に0を配列追加
    満杯盤面[0]=NULL
    満杯状態[「board」]=満杯盤面
    満杯状態[「legalMoves」]=満杯盤面で合法手一覧
    満杯コマンド={}
    満杯コマンド[「commandId」]=「full-1」
    満杯コマンド[「type」]=「place」
    満杯コマンド[「player」]=「dark」
    満杯コマンド[「expectedTurn」]=0
    満杯コマンド[「row」]=0
    満杯コマンド[「col」]=0
    満杯応答=満杯状態と満杯コマンドで着手適用
    「finished」と満杯応答[「state」][「phase」]がASSERT等
    「dark」と満杯応答[「state」][「winner」]がASSERT等

    # 色変換は四捨五入する。余り0/1/2と、Sが0と765の両端を固定する
    # 各行は[置く色, 変換対象の色, 固定端の色, 期待する変換後の色]
    丸め表=[[0,0,0,0],[1,0,0,0],[2,0,0,1],[3,0,0,1],[255,255,255,255]]
    丸め番号で0から((丸め表の要素数)-1)まで繰り返す:
        丸め行=丸め表[丸め番号]
        丸め状態=状態を深複製
        丸め盤面=[]
        64回:
            丸め盤面にNULLを配列追加
        丸め盤面[1]=丸め行[1]
        丸め盤面[2]=丸め行[2]
        丸め状態[「board」]=丸め盤面
        丸め状態[「nextColor」]=丸め行[0]
        丸め状態[「legalMoves」]=丸め盤面で合法手一覧
        丸めコマンド={}
        丸めコマンド[「commandId」]=「round-1」
        丸めコマンド[「type」]=「place」
        丸めコマンド[「player」]=「dark」
        丸めコマンド[「expectedTurn」]=0
        丸めコマンド[「row」]=0
        丸めコマンド[「col」]=0
        丸め応答=丸め状態と丸めコマンドで着手適用
        真と丸め応答[「ok」]がASSERT等
        丸め行[3]と丸め応答[「state」][「board」][1]がASSERT等

    # 連続パスの終局でも、色の重心がちょうど中央なら引き分けになる
    # (0,0)=0と(7,7)=255は離れているのでどの空きマスからも挟めず、合法手は0件
    引分状態=状態を深複製
    引分盤面=[]
    64回:
        引分盤面にNULLを配列追加
    引分盤面[0]=0
    引分盤面[63]=255
    引分状態[「board」]=引分盤面
    引分状態[「legalMoves」]=引分盤面で合法手一覧
    0と(引分状態[「legalMoves」]の要素数)がASSERT等
    引分パス1={}
    引分パス1[「commandId」]=「draw-pass-1」
    引分パス1[「type」]=「pass」
    引分パス1[「player」]=「dark」
    引分パス1[「expectedTurn」]=0
    引分応答1=引分状態と引分パス1でパス適用
    真と引分応答1[「ok」]がASSERT等
    引分パス2={}
    引分パス2[「commandId」]=「draw-pass-2」
    引分パス2[「type」]=「pass」
    引分パス2[「player」]=「light」
    引分パス2[「expectedTurn」]=1
    引分応答2=引分応答1[「state」]と引分パス2でパス適用
    「finished」と引分応答2[「state」][「phase」]がASSERT等
    真と(引分応答2[「state」][「winner」]==NULL)がASSERT等
    真と(引分応答2[「state」]で状態有効判定)がASSERT等

    # 盤面満杯の終局でも、色の重心がちょうど中央なら引き分けになる
    # 着手(0,0)で変換されるのは行0・列0・対角の駒だけなので、そこを0にして
    # 変換に関与しない42マスのうち32マスを255にすると色合計は8160になる
    満杯引分状態=状態を深複製
    満杯引分盤面=[]
    64回:
        満杯引分盤面に0を配列追加
    満杯引分盤面[0]=NULL
    白駒数=0
    添字で0から63まで繰り返す:
        変換対象=(添字<=7)または((添字%8)==0)または(INT(添字/8)==(添字%8))
        もし、(変換対象==偽)かつ(白駒数<32)ならば:
            満杯引分盤面[添字]=255
            白駒数=白駒数+1
    32と白駒数がASSERT等
    満杯引分状態[「board」]=満杯引分盤面
    満杯引分状態[「nextColor」]=0
    満杯引分状態[「legalMoves」]=満杯引分盤面で合法手一覧
    満杯引分コマンド={}
    満杯引分コマンド[「commandId」]=「draw-full-1」
    満杯引分コマンド[「type」]=「place」
    満杯引分コマンド[「player」]=「dark」
    満杯引分コマンド[「expectedTurn」]=0
    満杯引分コマンド[「row」]=0
    満杯引分コマンド[「col」]=0
    満杯引分応答=満杯引分状態と満杯引分コマンドで着手適用
    真と満杯引分応答[「ok」]がASSERT等
    「finished」と満杯引分応答[「state」][「phase」]がASSERT等
    真と(満杯引分応答[「state」][「winner」]==NULL)がASSERT等
    真と(満杯引分応答[「state」]で状態有効判定)がASSERT等

    # seed境界値も32bit範囲へ正規化される
    種0=0でLCG次状態
    種最大=4294967295でLCG次状態
    真と((種0>=0)かつ(種0<=4294967295))がASSERT等
    真と((種最大>=0)かつ(種最大<=4294967295))がASSERT等
ここまで

●CLI実行とは
    入力文字列=標準入力全取得
    要求=入力文字列をJSONデコード
    応答=要求で要求評価
    応答をJSONエンコードして表示
ここまで

引数一覧=コマンドライン
もし、(引数一覧の要素数)>0ならば:
    もし、引数一覧[0]==「--test」ならば:
        自己テスト
        「rules-ready」と表示
    違えば:
        CLI実行
違えば:
    CLI実行
